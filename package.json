{
  "name": "hydration-buddy",
  "productName": "Hydration Buddy",
  "version": "1.0.0",
  "description": "A friendly hydration companion for the Ubuntu desktop",
  "author": {
    "name": "Nishant Mahajan",
    "email": "nishant.mahajan@emorphis.in"
  },
  "license": "MIT",
  "private": true,
  "main": "dist-electron/main.js",
  "homepage": "https://localhost/hydration-buddy",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build && node scripts/build-main.mjs",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "icons": "node scripts/make-icons.mjs",
    "dist": "npm run build && electron-builder --linux AppImage deb",
    "dist:appimage": "npm run build && electron-builder --linux AppImage",
    "dist:deb": "npm run build && electron-builder --linux deb",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb",
    "dist:win": "npm run build && electron-builder --win nsis portable --x64",
    "dist:win:zip": "npm run build && electron-builder --win zip --x64 -c.win.signAndEditExecutable=false -c.win.artifactName=Hydration-Buddy-${version}-win-x64.${ext}"
  },
  "dependencies": {
    "sql.js": "1.12.0"
  },
  "devDependencies": {
    "@types/node": "20.17.6",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/sql.js": "1.4.9",
    "@types/three": "0.170.0",
    "@react-three/fiber": "8.17.10",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "electron": "33.4.11",
    "electron-builder": "25.1.8",
    "esbuild": "0.24.0",
    "framer-motion": "11.11.17",
    "postcss": "8.4.49",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwindcss": "3.4.17",
    "three": "0.170.0",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
